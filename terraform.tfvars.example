# Copie este arquivo para terraform.tfvars (ja esta no .gitignore) e
# preencha com os valores reais. NUNCA commite o terraform.tfvars.
#
# Alternativa sem arquivo: exporte como variaveis de ambiente antes do apply
#   export TF_VAR_db_user=postgres
#   export TF_VAR_db_pass=...
#   export TF_VAR_jwt_secret=...
#   export TF_VAR_mail_username=...
#   export TF_VAR_mail_password=...

db_user       = "postgres"
db_pass       = "troque-por-uma-senha-real"

# Minimo 32 bytes (256 bits) - a app usa os bytes crus da string (getBytes()),
# entao o tamanho do texto importa diretamente. Gere um valor novo com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
jwt_secret = "troque-por-uma-chave-com-pelo-menos-32-bytes"

mail_username = "seu-email@gmail.com"
mail_password = "app-password-do-gmail"
